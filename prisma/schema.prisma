generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  username          String?   @unique
  email             String    @unique
  password          String
  avatar            String?
  bio               String?
  role              Role      @default(USER)
  verified          Boolean   @default(false)
  verifyToken       String?   @unique
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  deleteToken       String?   @unique
  deleteTokenExpiry DateTime?
  storageUsedBytes  Float     @default(0)
  banned            Boolean   @default(false)
  bannedAt          DateTime?
  bannedReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  blogs                Blog[]
  comments             Comment[]
  likes                Like[]
  conversations1       Conversation[]       @relation("ConvUser1")
  conversations2       Conversation[]       @relation("ConvUser2")
  sentMessages         Message[]
  forumThreads         ForumThread[]
  forumReplies         ForumReply[]
  forumVotes           ForumVote[]
  groupsCreated        Group[]              @relation("GroupCreator")
  groupMembers         GroupMember[]
  groupPosts           GroupPost[]
  groupPostLikes       GroupPostLike[]
  following            Follow[]             @relation("Following")
  followers            Follow[]             @relation("Followers")
  notifications        Notification[]       @relation("ReceivedNotifications")
  notificationsSent    Notification[]       @relation("SentNotifications")
  thoughts             Thought[]
  thoughtLikes         ThoughtLike[]
  campaignsCreated     Campaign[]           @relation("CampaignCreator")
  campaignSupports     CampaignSupport[]
  challengesCreated    Challenge[]          @relation("ChallengeCreator")
  challengeSubmissions ChallengeSubmission[]
  challengeVotes       ChallengeVote[]

  @@map("users")
}

enum Role {
  USER
  AUTHOR
  ADMIN
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  icon        String?
  blogs       Blog[]

  @@map("categories")
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String   @db.Text
  image     String
  views     Int      @default(0)
  published Boolean  @default(false)
  featured  Boolean  @default(false)
  readTime  Int      @default(5)
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  comments   Comment[]
  likes      Like[]
  notifications Notification[]

  @@index([slug, authorId, categoryId])
  @@map("blogs")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  blogId   String
  blog     Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@map("likes")
}

model Newsletter {
  id         String   @id @default(cuid())
  email      String   @unique
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("newsletters")
}

model Conversation {
  id        String    @id @default(cuid())
  user1Id   String
  user1     User      @relation("ConvUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User      @relation("ConvUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum ForumCategory {
  GENERAL
  ZERO_WASTE
  CLIMATE
  PLANT_BASED
  ACTIVISM
  SUSTAINABLE_LIVING
  QUESTIONS
}

model ForumThread {
  id        String        @id @default(cuid())
  title     String
  content   String        @db.Text
  category  ForumCategory @default(GENERAL)
  pinned    Boolean       @default(false)
  views     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  authorId String
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies  ForumReply[]
  votes    ForumVote[]

  @@index([category, createdAt])
  @@map("forum_threads")
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("forum_replies")
}

model ForumVote {
  id       String @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@map("forum_votes")
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Group {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  image       String?
  category    ForumCategory @default(GENERAL)
  privacy     GroupPrivacy  @default(PUBLIC)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creatorId String
  creator   User          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  posts     GroupPost[]

  @@index([slug, category])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(cuid())
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

model GroupPost {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  authorId String
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  likes    GroupPostLike[]

  @@index([groupId, createdAt])
  @@map("group_posts")
}

model GroupPostLike {
  id     String @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("group_post_likes")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  CAMPAIGN_SUPPORT
  CHALLENGE_SUBMISSION
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId String
  recipient   User   @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User   @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  blogId  String?
  blog    Blog?   @relation(fields: [blogId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
  @@map("notifications")
}

// ── Quick Thoughts ──────────────────────────────────────────────────────────

model Thought {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(280)
  createdAt DateTime @default(now())

  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    ThoughtLike[]

  @@index([authorId, createdAt])
  @@map("thoughts")
}

model ThoughtLike {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  thoughtId String
  thought   Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  @@unique([userId, thoughtId])
  @@map("thought_likes")
}

// ── Campaigns ───────────────────────────────────────────────────────────────

enum CampaignStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Campaign {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String         @db.Text
  goal        String
  image       String?
  category    ForumCategory  @default(GENERAL)
  status      CampaignStatus @default(ACTIVE)
  targetCount Int            @default(100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creatorId  String
  creator    User              @relation("CampaignCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  supporters CampaignSupport[]
  updates    CampaignUpdate[]

  @@index([slug, status])
  @@map("campaigns")
}

model CampaignSupport {
  id         String   @id @default(cuid())
  joinedAt   DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@map("campaign_supports")
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  content    String   @db.Text
  createdAt  DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_updates")
}

// ── Writing Challenges ──────────────────────────────────────────────────────

enum ChallengeStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

model Challenge {
  id          String          @id @default(cuid())
  title       String
  prompt      String          @db.Text
  description String?         @db.Text
  category    ForumCategory   @default(GENERAL)
  status      ChallengeStatus @default(ACTIVE)
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creatorId   String
  creator     User                  @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  submissions ChallengeSubmission[]

  @@index([status, createdAt])
  @@map("challenges")
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  content     String   @db.Text
  createdAt   DateTime @default(now())

  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  votes       ChallengeVote[]

  @@unique([authorId, challengeId])
  @@index([challengeId, createdAt])
  @@map("challenge_submissions")
}

model ChallengeVote {
  id           String @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String
  submission   ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
  @@map("challenge_votes")
}

// ── Admin ───────────────────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetId   String
  targetType String
  note       String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_logs")
}
